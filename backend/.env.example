# Application Settings
ENVIRONMENT=production
SECRET_KEY=<generate-production-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings
MONGO_URI=<production-mongodb-url>
MONGO_DB_NAME=<production-database>

# CORS Settings (can be JSON array or comma-separated list)
ALLOWED_ORIGINS=["https://example.com"]

# CSV Upload Settings
MAX_CSV_FILE_SIZE_MB=2

# Frontend URL (used for public ticket QR code references)
FRONTEND_URL=https://example.com
